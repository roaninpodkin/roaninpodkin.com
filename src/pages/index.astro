---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import DepthGauge from '../components/DepthGauge.astro';
import Waterline from '../components/Waterline.astro';
import SectionHead from '../components/SectionHead.astro';
import SeaChart from '../components/SeaChart.astro';
import { DIVE, NAV, SITE } from '../consts';
import { href } from '../lib/url';
import copy from '../content/copy.json';
import portrait from '../assets/portrait.jpg';
import dennis from '../assets/dennis-two-shot.jpg';

const stories = (await getCollection('stories', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const year = new Date().getFullYear();
const { surface, river, openWater, islands, deep, testimonials, floor, seo } = copy;
const stop = (id: string) => DIVE.find((d) => d.id === id)!;
---

<BaseLayout
  title={seo.homeTitle}
  description={seo.homeDescription}
  type="profile"
  chrome={false}
  bodyClass="bg-sea-700"
>
  <DepthGauge stops={DIVE} />

  <!-- 0 m · Surface -->
  <section
    id="surface"
    data-depth="0"
    data-label={stop('surface').label}
    data-tone="light"
    class="relative flex min-h-[100svh] flex-col bg-[linear-gradient(to_bottom,#fcfdfd_0%,#eef4f6_100%)] text-ink"
  >
    <Header tone="light" />
    <div class="wrap grid flex-1 items-center gap-12 pt-32 pb-28 lg:grid-cols-[1.15fr_0.85fr] lg:pt-28">
      <div class="lg:pl-16 xl:pl-20">
        <p class="eyebrow text-tan-deep">{surface.eyebrow}</p>
        <h1 class="mt-5 font-display text-[clamp(3.4rem,10vw,8rem)] leading-[0.9] tracking-[-0.025em]">
          Roanin
          <br />
          Podkin
        </h1>
        <p class="mt-7 max-w-xl font-display text-[clamp(1.45rem,2.6vw,2.15rem)] leading-snug text-sea-500 italic">
          {surface.tagline}
        </p>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink/75">{surface.intro}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={`mailto:${SITE.email}`} class="btn btn-ink">
            Email me
          </a>
          <a href={SITE.linkedin} rel="me noopener" class="btn btn-ghost">
            LinkedIn
          </a>
        </div>
      </div>

      <figure class="justify-self-center lg:justify-self-end">
        <div class="relative w-[min(72vw,19rem)] overflow-hidden rounded-t-full rounded-b-[2rem] shadow-[0_40px_70px_-40px_rgba(11,27,43,0.55)] ring-1 ring-ink/10 lg:w-[23rem]">
          <Image
            src={portrait}
            alt="Roanin Podkin on the summit of Mt Bierstadt, thumbs up"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 23rem, 72vw"
            class="h-auto w-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="eyebrow mt-4 text-center text-ink/50 lg:text-right">
          Mt Bierstadt, 14,065 ft · Aug 2026
        </figcaption>
      </figure>
    </div>

    <a
      href="#river"
      class="absolute bottom-24 left-1/2 flex -translate-x-1/2 items-center gap-2 text-sm text-ink/60 transition hover:text-ink md:bottom-28"
    >
      <span>{surface.scrollCue}</span>
      <span class="inline-block [animation:bob_2.4s_ease-in-out_infinite]" aria-hidden="true">
        ↓
      </span>
    </a>
  </section>

  <!-- 5 m · The river -->
  <section
    id="river"
    data-depth="5"
    data-label={stop('river').label}
    data-tone="light"
    class="relative bg-[linear-gradient(to_bottom,var(--color-sea-100),var(--color-sea-300))] pt-24 pb-36 text-ink"
  >
    <Waterline fill="var(--color-sea-100)" />
    <div class="wrap">
      <SectionHead
        eyebrow="5 m · Where I come from"
        heading={river.heading}
        lede={river.lede}
        tone="light"
      />

      <div class="relative mt-20">
        <svg
          class="pointer-events-none absolute inset-0 hidden h-full w-full md:block"
          viewBox="0 0 1000 600"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M-40 70 C 160 110, 330 80, 520 140 C 720 200, 920 220, 880 330 C 840 430, 640 420, 520 470 C 400 520, 300 570, 200 640"
            fill="none"
            stroke="rgba(255,255,255,0.42)"
            stroke-width="34"
            stroke-linecap="round"
          ></path>
          <path
            d="M-40 70 C 160 110, 330 80, 520 140 C 720 200, 920 220, 880 330 C 840 430, 640 420, 520 470 C 400 520, 300 570, 200 640"
            fill="none"
            stroke="rgba(255,255,255,0.8)"
            stroke-width="2.5"
            stroke-dasharray="2 14"
            stroke-linecap="round"
          ></path>
        </svg>
        <div
          class="pointer-events-none absolute top-0 bottom-0 left-4 w-px border-l border-dashed border-white/70 md:hidden"
          aria-hidden="true"
        ></div>

        <ol class="relative grid gap-8 pl-10 md:grid-cols-12 md:gap-y-6 md:pl-0">
          {river.stones.map((s, i) => (
            <li
              class={`reveal stone ${
                i === 0
                  ? 'md:col-span-5 md:col-start-1'
                  : i === 1
                    ? 'md:col-span-5 md:col-start-7 md:mt-28'
                    : 'md:col-span-5 md:col-start-4 md:-mt-4'
              }`}
            >
              <span class="eyebrow text-tan-deep">Stone {i + 1}</span>
              <h3 class="mt-2 font-display text-3xl md:text-4xl">{s.title}</h3>
              <p class="mt-4 leading-relaxed text-ink/80">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 12 m · Open water -->
  <section
    id="open-water"
    data-depth="12"
    data-label={stop('open-water').label}
    data-tone="dark"
    class="relative overflow-hidden bg-[linear-gradient(to_bottom,var(--color-sea-400),var(--color-sea-500))] pt-28 pb-36 text-foam"
  >
    <Waterline fill="var(--color-sea-400)" />
    <div class="shaft left-[8%]" style="animation-delay:-3s"></div>
    <div class="shaft left-[38%]" style="animation-delay:-9s; width: 10vw"></div>
    <div class="shaft left-[70%]" style="animation-delay:-6s"></div>

    <div class="wrap relative">
      <SectionHead
        eyebrow="12 m · How I decide"
        heading={openWater.heading}
        lede={openWater.lede}
      />

      <div class="mt-16 grid gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
        <div class="reveal">
          <p class="max-w-xl text-lg leading-relaxed text-foam/85">{openWater.valuesIntro}</p>
          <ol class="mt-10 space-y-8">
            {openWater.valuesTop.map((v, i) => (
              <li class="grid grid-cols-[3rem_1fr] gap-4">
                <span class="font-display text-4xl leading-none text-tan tabular-nums">
                  0{i + 1}
                </span>
                <div>
                  <h3 class="font-display text-3xl leading-none">{v.name}</h3>
                  <p class="mt-2 leading-relaxed text-foam/80">{v.line}</p>
                </div>
              </li>
            ))}
          </ol>
          <ul class="mt-10 flex flex-wrap gap-2 pl-[4rem]">
            {openWater.valuesRest.map((v, i) => (
              <li class="rounded-full border border-foam/25 px-3.5 py-1 text-sm text-foam/85">
                <span class="mr-1.5 font-display text-foam/50 tabular-nums">0{i + 3}</span>
                {v}
              </li>
            ))}
          </ul>
          <p class="mt-10 max-w-xl border-l-2 border-tan pl-5 font-display text-2xl leading-snug text-sand-100">
            {openWater.moneyRule}
          </p>
        </div>

        <div class="reveal flex items-start justify-center lg:justify-end lg:pt-6">
          <figure class="wall-note w-full max-w-sm">
            <blockquote class="font-display text-[1.7rem] leading-[1.25]">
              {openWater.wallNote.quote}
            </blockquote>
            <figcaption class="eyebrow mt-6 text-tan-deep">{openWater.wallNote.caption}</figcaption>
          </figure>
        </div>
      </div>

      <div class="mt-24 grid gap-12 border-t border-foam/15 pt-16 md:grid-cols-2 md:gap-16">
        <div class="reveal">
          <h3 class="font-display text-3xl md:text-4xl">{openWater.stepBack.heading}</h3>
          <p class="mt-4 leading-relaxed text-foam/85">{openWater.stepBack.body}</p>
        </div>
        <div class="reveal">
          <h3 class="font-display text-3xl md:text-4xl">{openWater.aiArc.heading}</h3>
          <p class="mt-4 leading-relaxed text-foam/85">{openWater.aiArc.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 20 m · The islands -->
  <section
    id="islands"
    data-depth="20"
    data-label={stop('islands').label}
    data-tone="dark"
    class="relative overflow-hidden bg-[linear-gradient(to_bottom,var(--color-sea-500),#1d4670)] pt-28 pb-32 text-foam"
  >
    <div class="wrap">
      <SectionHead eyebrow="20 m · Stories" heading={islands.heading} lede={islands.lede} />
      <div class="reveal mt-12">
        <SeaChart stories={stories} bare />
      </div>
      <p class="mt-12 text-center">
        <a href={href('/stories/')} class="link-tan">
          All stories, in order
        </a>
      </p>
    </div>
  </section>

  <!-- 30 m · The deep -->
  <section
    id="the-deep"
    data-depth="30"
    data-label={stop('the-deep').label}
    data-tone="dark"
    class="relative overflow-hidden bg-[linear-gradient(to_bottom,var(--color-sea-600),var(--color-sea-700))] pt-28 pb-36 text-foam"
  >
    {[
      ['6%', '7px', '21s', '-2s'],
      ['14%', '12px', '26s', '-11s'],
      ['31%', '6px', '19s', '-7s'],
      ['52%', '9px', '24s', '-15s'],
      ['68%', '14px', '29s', '-4s'],
      ['83%', '7px', '22s', '-18s'],
      ['93%', '10px', '25s', '-9s'],
    ].map(([l, s, d, delay]) => (
      <span
        class="bubble"
        style={`left:${l}; --s:${s}; --d:${d}; --delay:${delay}`}
        aria-hidden="true"
      />
    ))}

    <div class="wrap relative">
      <SectionHead eyebrow="30 m · Now" heading={deep.heading} lede={deep.lede} />

      <!-- Avoca -->
      <div class="reveal mt-16 grid gap-10 rounded-[2rem] bg-white/[0.04] p-8 ring-1 ring-white/10 md:p-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <p class="eyebrow text-tan">Where I work</p>
          <h3 class="mt-3 font-display text-[clamp(3rem,6vw,5.5rem)] leading-none">
            <a href={SITE.avoca} rel="noopener" class="hover:text-tan">
              {deep.avoca.heading}
            </a>
          </h3>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-foam/90">{deep.avoca.what}</p>
          <p class="mt-4 max-w-xl leading-relaxed text-foam/80">{deep.avoca.myRole}</p>
          <p class="mt-4 max-w-xl leading-relaxed text-foam/80">{deep.avoca.why}</p>
        </div>
        <aside class="self-center rounded-3xl bg-sand-100 p-8 text-ink shadow-[0_40px_60px_-40px_rgba(0,0,0,0.7)]">
          <p class="eyebrow text-tan-deep">For owners</p>
          <p class="mt-3 font-display text-2xl leading-snug">{deep.avoca.forOwners}</p>
          <a href={SITE.booking} rel="noopener" class="btn btn-lagoon mt-6 w-full text-base">
            {deep.avoca.cta}
          </a>
          <p class="mt-3 text-center text-sm text-ink/60">{deep.avoca.ctaSub}</p>
        </aside>
      </div>

      <div class="mt-20 grid gap-12 md:grid-cols-2 md:gap-16">
        <div class="reveal">
          <h3 class="font-display text-3xl md:text-4xl">{deep.consulting.heading}</h3>
          <p class="mt-4 leading-relaxed text-foam/85">{deep.consulting.body}</p>
          <ul class="mt-6 grid gap-2 sm:grid-cols-2">
            {deep.consulting.bullets.map((b) => (
              <li class="flex items-center gap-3 text-foam/85">
                <span class="h-1.5 w-1.5 rounded-full bg-tan" aria-hidden="true" />
                {b}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal">
          <h3 class="font-display text-3xl md:text-4xl">{deep.project.heading}</h3>
          <p class="mt-4 leading-relaxed text-foam/85">{deep.project.body}</p>
        </div>
      </div>

      <!-- Testimonials -->
      <div class="mt-28">
        <SectionHead heading={testimonials.heading} lede={testimonials.lede} />
        <div class="mt-12 grid gap-8 lg:grid-cols-3">
          {testimonials.items.map((t, i) => (
            <figure
              class={`reveal flex flex-col justify-between rounded-3xl p-7 ring-1 ring-white/10 ${i === 2 ? 'bg-sea-500/40' : 'bg-white/[0.04]'}`}
            >
              <blockquote class="font-display text-2xl leading-snug text-sand-100">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-8 flex items-center gap-4">
                {i === 2 && (
                  <Image
                    src={dennis}
                    alt="Roanin and Dennis Yu recording episode one"
                    width={112}
                    height={112}
                    class="h-14 w-14 rounded-full object-cover ring-2 ring-tan/50"
                  />
                )}
                <div class="text-sm">
                  <p class="font-medium text-foam">
                    {'href' in t && t.href ? (
                      <a href={t.href} rel="noopener" class="link">
                        {t.name}
                      </a>
                    ) : (
                      t.name
                    )}
                  </p>
                  <p class="text-foam/65">{t.title}</p>
                  <p class="mt-1 text-foam/45">{t.context}</p>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 40 m · The floor -->
  <section
    id="the-floor"
    data-depth="40"
    data-label={stop('the-floor').label}
    data-tone="dark"
    class="relative overflow-hidden bg-[linear-gradient(to_bottom,var(--color-sea-700),var(--color-abyss))] pt-32 pb-10 text-foam"
  >
    {[
      ['8%', '22%', '4.2s', '-1s'],
      ['21%', '68%', '6.1s', '-3s'],
      ['33%', '35%', '5.3s', '-2s'],
      ['47%', '80%', '7s', '-4s'],
      ['58%', '18%', '4.8s', '-0.5s'],
      ['66%', '55%', '6.6s', '-2.5s'],
      ['79%', '30%', '5.5s', '-1.5s'],
      ['88%', '72%', '4.4s', '-3.5s'],
      ['94%', '45%', '6.2s', '-0.8s'],
      ['14%', '88%', '5.8s', '-2.2s'],
    ].map(([l, t, d, delay]) => (
      <span
        class="spark"
        style={`left:${l}; top:${t}; --d:${d}; --delay:${delay}`}
        aria-hidden="true"
      />
    ))}

    <div class="wrap relative">
      <div class="reveal mx-auto max-w-4xl text-center">
        <p class="eyebrow text-tan">40 m · {floor.heading}</p>
        <p class="mt-6 font-display text-[clamp(2rem,5vw,4.2rem)] leading-[1.1]">{floor.line}</p>
        <div class="mt-12 flex flex-wrap justify-center gap-3">
          <a href={`mailto:${SITE.email}`} class="btn btn-foam text-base">
            {floor.cta}
          </a>
          <a href={SITE.linkedin} rel="me noopener" class="btn btn-ghost text-base">
            LinkedIn
          </a>
        </div>
        <p class="mt-6 text-sm text-foam/50">{SITE.email}</p>
      </div>

      <footer class="mt-28 flex flex-col gap-4 border-t border-foam/10 pt-6 text-sm text-foam/50 md:flex-row md:items-center md:justify-between">
        <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
          {NAV.map((n) => (
            <a href={href(n.path)} class="hover:text-foam">
              {n.label}
            </a>
          ))}
          <a href={href('/contact/')} class="hover:text-foam">
            Contact
          </a>
        </nav>
        <p>
          &copy; {year} {SITE.name} ·{' '}
          <a href="#surface" class="hover:text-foam">
            Back to the surface ↑
          </a>
        </p>
      </footer>
    </div>
  </section>
</BaseLayout>
