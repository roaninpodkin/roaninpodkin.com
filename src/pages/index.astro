---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import DiverGauge from '../components/DiverGauge.astro';
import Waterline from '../components/Waterline.astro';
import IslandsSection from '../components/IslandsSection.astro';
import SectionHead from '../components/SectionHead.astro';
import { DIVE, NAV, SITE } from '../consts';
import { href } from '../lib/url';
import copy from '../content/copy.json';
import avocaLogo from '../assets/avoca-logo.svg?raw';
import portrait from '../content/logbook/sintra/moorish-castle.jpg';
import whaleSharks from '../content/logbook/saleh-bay/whale-sharks.jpg';
import chefHat from '../content/logbook/santa-barbara/avoca-september.jpg';
import dennis from '../assets/dennis-two-shot.jpg';

const stories = await getCollection('stories', ({ data }) => !data.draft);
const year = new Date().getFullYear();
const { surface, islands, now, testimonials, floor, seo } = copy;
const stop = (id: string) => DIVE.find((d) => d.id === id)!;
---

<BaseLayout
  title={seo.homeTitle}
  description={seo.homeDescription}
  type="profile"
  chrome={false}
  bodyClass="bg-abyss"
>
  <DiverGauge stops={DIVE} />

  <!-- 0 m · Surface -->
  <section
    id="surface"
    data-label={stop('surface').label}
    class="relative bg-[linear-gradient(to_bottom,#fbfdfe,#e8f1f4)] text-ink"
  >
    <Header tone="light" class="max-md:text-foam" />
    <div class="grid min-h-[100svh] md:grid-cols-2">
      <figure class="relative order-1 h-[64svh] md:order-2 md:h-auto md:min-h-[100svh]">
        <Image
          src={portrait}
          alt="Roanin Podkin grinning with his arms out on an old castle wall"
          widths={[640, 960, 1400]}
          sizes="(min-width: 768px) 50vw, 100vw"
          quality={72}
          layout="none"
          class="absolute inset-0 h-full w-full object-cover object-[50%_28%]"
          loading="eager"
          fetchpriority="high"
        />
        <div
          class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-ink/55 to-transparent md:hidden"
          aria-hidden="true"
        ></div>
        <div
          class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-[#e8f1f4] to-transparent md:hidden"
          aria-hidden="true"
        ></div>
      </figure>
      <div class="order-2 flex items-center px-6 pb-28 md:order-1 md:px-12 md:pt-24 lg:px-16 xl:px-24">
        <div class="max-w-xl">
          <p class="eyebrow text-tan-deep">{surface.eyebrow}</p>
          <h1 class="mt-4 font-display text-[clamp(3.4rem,8vw,7.2rem)] leading-[0.9] tracking-[-0.025em]">
            Roanin
            <br />
            Podkin
          </h1>
          <p class="mt-7 max-w-lg text-lg leading-relaxed text-ink/80 md:text-xl">
            {surface.intro}
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={`mailto:${SITE.email}`} class="btn btn-ink">
              Email me
            </a>
            <a href={SITE.linkedin} rel="me noopener" class="btn btn-ghost">
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>
    <a
      href="#islands"
      class="absolute bottom-28 left-12 z-10 hidden items-center gap-2 text-sm text-ink/60 transition hover:text-ink md:flex lg:left-16 xl:left-24"
    >
      <span>{surface.scrollCue}</span>
      <span class="inline-block [animation:bob_2.4s_ease-in-out_infinite]" aria-hidden="true">
        ↓
      </span>
    </a>
    <Waterline fill="#2f6482" position="bottom" />
  </section>

  <!-- 10 m · The islands -->
  <IslandsSection
    stories={stories}
    id="islands"
    label={stop('islands').label}
    heading={islands.heading}
    lede={islands.lede}
  />

  <!-- 24 m · Now -->
  <section
    id="now"
    data-label={stop('now').label}
    class="relative overflow-hidden bg-[linear-gradient(to_bottom,#1c4570,var(--color-sea-700))] pt-24 pb-28 text-foam md:pt-32"
  >
    <div class="wrap">
      <SectionHead eyebrow="Now" heading={now.heading} />

      <div class="reveal mt-12 grid gap-10 rounded-[2rem] bg-white/[0.04] p-7 ring-1 ring-white/10 md:p-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
        <div>
          <a
            href={SITE.avoca}
            rel="noopener"
            class="inline-block text-foam transition hover:text-tan [&_svg]:h-9 [&_svg]:w-auto md:[&_svg]:h-11"
            aria-label="Avoca"
            set:html={avocaLogo}
          />
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-foam/90 md:text-xl">
            {now.avoca.what}
          </p>
          <p class="mt-4 max-w-xl leading-relaxed text-foam/80">{now.avoca.myRole}</p>
          <p class="mt-4 max-w-xl leading-relaxed text-foam/80">{now.avoca.why}</p>
          <figure class="mt-8 flex items-center gap-4">
            <Image
              src={chefHat}
              alt="Roanin in a chef hat holding up one finger in front of the Avoca West sign"
              width={192}
              height={240}
              layout="none"
              class="h-24 w-[4.8rem] rounded-xl object-cover ring-1 ring-white/15"
            />
            <figcaption class="max-w-[16rem] text-sm leading-snug text-foam/70">
              {now.avoca.badge}
            </figcaption>
          </figure>
        </div>
        <aside class="self-center rounded-3xl bg-sand-100 p-7 text-ink shadow-[0_40px_60px_-40px_rgba(0,0,0,0.7)] md:p-8">
          <p class="eyebrow text-tan-deep">For owners</p>
          <p class="mt-3 font-display text-2xl leading-snug">{now.avoca.forOwners}</p>
          <a href={SITE.booking} rel="noopener" class="btn btn-lagoon mt-6 w-full text-base">
            {now.avoca.cta}
          </a>
          <p class="mt-3 text-center text-sm text-ink/60">{now.avoca.ctaSub}</p>
        </aside>
      </div>

      <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-14">
        <div class="reveal">
          <h3 class="font-display text-3xl md:text-4xl">{now.consulting.heading}</h3>
          <p class="mt-4 leading-relaxed text-foam/85">{now.consulting.body}</p>
          <ul class="mt-6 grid gap-2 sm:grid-cols-2">
            {now.consulting.bullets.map((b) => (
              <li class="flex items-center gap-3 text-foam/85">
                <span class="h-1.5 w-1.5 rounded-full bg-tan" aria-hidden="true" />
                {b}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal">
          <h3 class="font-display text-3xl md:text-4xl">{now.project.heading}</h3>
          <p class="mt-4 leading-relaxed text-foam/85">{now.project.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 32 m · What people say -->
  <section
    id="voices"
    data-label={stop('voices').label}
    class="relative bg-sea-700 pt-8 pb-28 text-foam"
  >
    <div class="wrap">
      <SectionHead heading={testimonials.heading} lede={testimonials.lede} />
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {testimonials.items.map((t, i) => (
          <figure
            class={`reveal flex flex-col justify-between rounded-3xl p-7 ring-1 ring-white/10 ${i === 2 ? 'bg-sea-500/40' : 'bg-white/[0.04]'}`}
          >
            <blockquote class="font-display text-2xl leading-snug text-sand-100">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-4">
              {i === 2 && (
                <Image
                  src={dennis}
                  alt="Roanin and Dennis Yu recording episode one"
                  width={112}
                  height={112}
                  layout="none"
                  class="h-14 w-14 rounded-full object-cover ring-2 ring-tan/50"
                />
              )}
              <div class="text-sm">
                <p class="font-medium text-foam">
                  {'href' in t && t.href ? (
                    <a href={t.href} rel="noopener" class="link">
                      {t.name}
                    </a>
                  ) : (
                    t.name
                  )}
                </p>
                <p class="text-foam/65">{t.title}</p>
                <p class="mt-1 text-foam/45">{t.context}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 40 m · The floor -->
  <section
    id="floor"
    data-label={stop('floor').label}
    class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden text-foam"
  >
    <Image
      src={whaleSharks}
      alt="Roanin underwater, shaka up, beside two whale sharks"
      widths={[800, 1200, 1800, 2400]}
      sizes="100vw"
      quality={72}
      layout="none"
      class="absolute inset-0 h-full w-full object-cover object-[55%_60%]"
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-abyss via-abyss/60 to-sea-500/10"
      aria-hidden="true"
    ></div>
    <div class="wrap relative pt-[55svh] pb-8">
      <div class="reveal max-w-3xl">
        <p class="eyebrow text-tan">{floor.heading}</p>
        <p class="mt-5 font-display text-[clamp(2rem,4.6vw,4rem)] leading-[1.08]">{floor.line}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`mailto:${SITE.email}`} class="btn btn-foam text-base">
            {floor.cta}
          </a>
          <a href={SITE.linkedin} rel="me noopener" class="btn btn-ghost text-base">
            LinkedIn
          </a>
        </div>
        <p class="mt-5 text-sm text-foam/60">{SITE.email}</p>
      </div>
      <footer class="mt-20 flex flex-col gap-4 border-t border-foam/15 pt-6 text-sm text-foam/60 md:flex-row md:items-center md:justify-between">
        <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
          {NAV.map((n) => (
            <a href={href(n.path)} class="hover:text-foam">
              {n.label}
            </a>
          ))}
          <a href={href('/contact/')} class="hover:text-foam">
            Contact
          </a>
        </nav>
        <p>
          &copy; {year} {SITE.name} ·{' '}
          <a href="#surface" class="hover:text-foam">
            Back to the surface ↑
          </a>
        </p>
      </footer>
    </div>
  </section>
</BaseLayout>
