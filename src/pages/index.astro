---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout description={SITE.description}>
  <section class="py-16 sm:py-24">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{SITE.name}</h1>
    <p class="mt-6 max-w-prose text-lg text-neutral-600 dark:text-neutral-400">
      Welcome. This site is under construction — more soon.
    </p>
  </section>
</BaseLayout>
