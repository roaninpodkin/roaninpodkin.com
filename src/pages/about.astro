---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { href } from '../lib/url';
import copy from '../content/copy.json';
import alps from '../content/logbook/switzerland/alps.jpg';

const { about } = copy;
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
  ],
};
---

<BaseLayout
  title={about.title}
  description={about.description}
  type="profile"
  tone="light"
  current="/about/"
  bodyClass="bg-sand-100"
  jsonLd={[crumbs]}
>
  <article class="pt-32 pb-24">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-20">
      <div>
        <p class="eyebrow text-tan-deep">About</p>
        <h1 class="mt-3 font-display text-[clamp(2.8rem,6vw,5.2rem)] leading-[1.02]">
          {about.title}
        </h1>

        <div class="prose prose-sand prose-lg mt-12 max-w-[68ch] prose-headings:font-display prose-p:leading-[1.75]">
          {about.sections.map((s) => (
            <section>
              <h2>{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </section>
          ))}
        </div>

        <section
          class="mt-16 rounded-[2rem] bg-sea-700 p-8 text-foam md:p-10"
          aria-labelledby="values"
        >
          <p class="eyebrow text-tan">{about.values.heading}</p>
          <p id="values" class="mt-3 max-w-xl font-display text-2xl leading-snug">
            {about.values.intro}
          </p>
          <div class="mt-8 grid gap-8 md:grid-cols-[1fr_1.4fr]">
            <div class="rounded-2xl bg-white/[0.06] p-6 ring-1 ring-white/10">
              <p class="eyebrow text-tan">First</p>
              <h3 class="mt-2 font-display text-3xl">{about.values.first.name}</h3>
              <p class="mt-2 text-foam/80">{about.values.first.line}</p>
            </div>
            <ul class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
              {about.values.rest.map((v) => (
                <li>
                  <h3 class="font-display text-2xl">{v.name}</h3>
                  <p class="mt-0.5 text-sm text-foam/75">{v.line}</p>
                </li>
              ))}
            </ul>
          </div>
          <p class="mt-8 border-l-2 border-tan pl-5 font-display text-xl leading-snug text-sand-100">
            {about.values.rule}
          </p>
          <p class="mt-5 text-sm text-foam/65">{about.values.wallNote}</p>
        </section>

        <div class="mt-12 flex flex-wrap gap-3">
          <a href={`mailto:${SITE.email}`} class="btn btn-ink">
            Email me
          </a>
          <a href={SITE.linkedin} rel="me noopener" class="btn btn-ghost">
            LinkedIn
          </a>
          <a href={href('/stories/')} class="btn btn-ghost">
            Read the stories
          </a>
        </div>
      </div>

      <aside class="lg:pt-24">
        <div class="overflow-hidden rounded-t-full rounded-b-[2rem] ring-1 ring-ink/10">
          <Image
            src={alps}
            alt="Roanin sitting on a rock looking out over the Alps"
            widths={[400, 640, 800]}
            sizes="(min-width: 1024px) 20rem, 80vw"
            class="h-auto w-full"
          />
        </div>
        <dl class="mt-8 space-y-4 text-sm">
          <div>
            <dt class="eyebrow text-tan-deep">Now</dt>
            <dd class="mt-1">
              Sales development,{' '}
              <a href={SITE.avoca} rel="noopener" class="link">
                Avoca
              </a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow text-tan-deep">Based</dt>
            <dd class="mt-1">{SITE.location}</dd>
          </div>
          <div>
            <dt class="eyebrow text-tan-deep">From</dt>
            <dd class="mt-1">Vacaville, California</dd>
          </div>
          <div>
            <dt class="eyebrow text-tan-deep">School</dt>
            <dd class="mt-1">UC Santa Barbara, Economics, 2026</dd>
          </div>
        </dl>
      </aside>
    </div>
  </article>
</BaseLayout>
