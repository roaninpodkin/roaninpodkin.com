---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeaChart from '../../components/SeaChart.astro';
import { SITE } from '../../consts';
import { href } from '../../lib/url';
import copy from '../../content/copy.json';

const stories = (await getCollection('stories', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const pad = (n: number) => String(n).padStart(2, '0');
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Stories', item: `${SITE.url}/stories/` },
  ],
};
---

<BaseLayout
  title="Stories"
  description={`${copy.islands.lede} Nine stories from Vacaville to Mt Bierstadt, drawn as islands on a chart.`}
  current="/stories/"
  bodyClass="bg-sea-500"
  jsonLd={[crumbs]}
>
  <section class="bg-[linear-gradient(to_bottom,var(--color-sea-500),#1d4670)] pt-32 pb-24 text-foam">
    <div class="wrap">
      <p class="eyebrow text-tan">Stories</p>
      <h1 class="mt-3 font-display text-[clamp(2.8rem,6vw,5.2rem)] leading-[1.02]">
        {copy.islands.heading}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-foam/75 md:text-xl">{copy.islands.lede}</p>

      <div class="mt-12">
        <SeaChart stories={stories} bare />
      </div>

      <ol class="mt-20 hidden divide-y divide-foam/10 border-y border-foam/10 md:block">
        {stories.map((s, i) => (
          <li>
            <a
              href={href(`/stories/${s.id}/`)}
              class="group grid grid-cols-[3rem_1fr_auto] items-baseline gap-6 py-6 transition hover:bg-white/[0.03]"
            >
              <span class="font-display text-2xl text-tan tabular-nums">{pad(i + 1)}</span>
              <span>
                <span class="block font-display text-3xl group-hover:underline group-hover:decoration-tan group-hover:underline-offset-4">
                  {s.data.title}
                </span>
                <span class="mt-1 block text-foam/70">{s.data.excerpt}</span>
              </span>
              <span class="eyebrow text-right text-foam/50">
                {s.data.place}
                <br />
                {s.data.dateLabel}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
