---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IslandsSection from '../../components/IslandsSection.astro';
import { SITE } from '../../consts';
import { href } from '../../lib/url';
import copy from '../../content/copy.json';

const stories = await getCollection('stories', ({ data }) => !data.draft);
const chain = stories.filter((s) => !s.data.quest).sort((a, b) => a.data.order - b.data.order);
const quests = stories.find((s) => s.data.quest);
const ordered = quests ? [...chain, quests] : chain;
const pad = (n: number) => String(n).padStart(2, '0');
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Stories', item: `${SITE.url}/stories/` },
  ],
};
---

<BaseLayout
  title="Stories"
  description="Roanin Podkin's story as islands on a chart: Vacaville, the farm, UCSB, two months solo in Asia, teaching himself AI, La Cumbre, Avoca, and the side quests."
  current="/stories/"
  bodyClass="bg-sea-700"
  jsonLd={[crumbs]}
>
  <IslandsSection
    stories={stories}
    id="chart"
    heading={copy.islands.heading}
    lede={copy.islands.lede}
    asPage
  />

  <section class="bg-sea-700 py-20 text-foam">
    <div class="wrap">
      <p class="eyebrow text-tan">In order</p>
      <ol class="mt-6 divide-y divide-foam/10 border-y border-foam/10">
        {ordered.map((s, i) => (
          <li>
            <a
              href={href(`/stories/${s.id}/`)}
              data-island={s.id}
              class="group grid grid-cols-[3rem_1fr] items-baseline gap-4 py-6 transition hover:bg-white/[0.03] md:grid-cols-[3rem_1fr_auto] md:gap-6"
            >
              <span class="font-display text-2xl text-tan tabular-nums">
                {s.data.quest ? '★' : pad(i + 1)}
              </span>
              <span>
                <span class="block font-display text-3xl group-hover:underline group-hover:decoration-tan group-hover:underline-offset-4">
                  {s.data.title}
                </span>
                <span class="mt-1 block text-foam/70">{s.data.excerpt}</span>
              </span>
              <span class="eyebrow hidden text-right text-foam/50 md:block">
                {s.data.place}
                <br />
                {s.data.dateLabel}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
