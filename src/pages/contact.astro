---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import copy from '../content/copy.json';

const { contact } = copy;
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE.url}/contact/` },
  ],
};
---

<BaseLayout
  title={contact.title}
  description={contact.description}
  current="/contact/"
  bodyClass="bg-sea-700"
  jsonLd={[crumbs]}
>
  <section class="relative flex min-h-[70svh] items-center overflow-hidden bg-[linear-gradient(to_bottom,var(--color-sea-700),var(--color-abyss))] pt-32 pb-24 text-foam">
    {[
      ['10%', '30%', '4.2s', '-1s'],
      ['25%', '75%', '6.1s', '-3s'],
      ['40%', '20%', '5.3s', '-2s'],
      ['62%', '82%', '7s', '-4s'],
      ['78%', '28%', '4.8s', '-0.5s'],
      ['90%', '60%', '6.6s', '-2.5s'],
    ].map(([l, t, d, delay]) => (
      <span
        class="spark"
        style={`left:${l}; top:${t}; --d:${d}; --delay:${delay}`}
        aria-hidden="true"
      />
    ))}
    <div class="wrap relative max-w-3xl">
      <p class="eyebrow text-tan">Contact</p>
      <h1 class="mt-3 font-display text-[clamp(2.8rem,6vw,5.2rem)] leading-[1.02]">
        {contact.title}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-foam/80">{contact.body}</p>

      <ul class="mt-12 space-y-5">
        <li>
          <span class="eyebrow text-foam/50">Email</span>
          <a
            href={`mailto:${SITE.email}`}
            class="mt-1 block font-display text-3xl hover:text-tan md:text-4xl"
          >
            {SITE.email}
          </a>
        </li>
        <li>
          <span class="eyebrow text-foam/50">LinkedIn</span>
          <a
            href={SITE.linkedin}
            rel="me noopener"
            class="mt-1 block font-display text-3xl hover:text-tan md:text-4xl"
          >
            linkedin.com/in/roanin-podkin
          </a>
        </li>
        <li>
          <span class="eyebrow text-foam/50">Home-service owners</span>
          <a
            href={SITE.booking}
            rel="noopener"
            class="mt-1 block font-display text-3xl hover:text-tan md:text-4xl"
          >
            Book 20 minutes with me
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
