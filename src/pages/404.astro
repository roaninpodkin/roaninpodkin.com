---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/url';
---

<BaseLayout
  title="Page not found"
  description="That page isn't on the chart."
  noindex
  bodyClass="bg-sea-700"
>
  <section class="flex min-h-[70svh] items-center bg-[linear-gradient(to_bottom,var(--color-sea-600),var(--color-sea-700))] pt-32 pb-24 text-foam">
    <div class="wrap max-w-2xl">
      <p class="eyebrow text-tan">404</p>
      <h1 class="mt-3 font-display text-[clamp(2.8rem,6vw,5.2rem)] leading-[1.02]">
        Not on the chart
      </h1>
      <p class="mt-5 text-lg text-foam/75">
        That page doesn't exist.{' '}
        <a href={href('/')} class="link-tan">
          Back to the surface
        </a>{' '}
        or
        <a href={href('/stories/')} class="link-tan">
          pick an island
        </a>
        .
      </p>
    </div>
  </section>
</BaseLayout>
