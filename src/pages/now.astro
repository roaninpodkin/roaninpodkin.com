---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import copy from '../content/copy.json';
import avocaLogo from '../assets/avoca-logo.svg?raw';

const page = copy.nowPage;
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Now', item: `${SITE.url}/now/` },
  ],
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  current="/now/"
  bodyClass="bg-sea-700"
  jsonLd={[crumbs]}
>
  <article class="relative overflow-hidden bg-[linear-gradient(to_bottom,var(--color-sea-600),var(--color-sea-700))] pt-32 pb-24 text-foam">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-20">
      <div>
        <p class="eyebrow text-tan">Now</p>
        <h1 class="mt-3 font-display text-[clamp(2.8rem,6vw,5.2rem)] leading-[1.02]">
          {page.title}
        </h1>
        <a
          href={SITE.avoca}
          rel="noopener"
          class="mt-8 inline-block text-foam transition hover:text-tan [&_svg]:h-9 [&_svg]:w-auto"
          aria-label="Avoca"
          set:html={avocaLogo}
        />
        <div class="prose prose-sea prose-lg mt-8 max-w-[68ch] prose-headings:font-display prose-p:leading-[1.75]">
          {page.sections.map((s) => (
            <section>
              <h2>{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </section>
          ))}
        </div>
      </div>

      <aside class="self-start rounded-3xl bg-sand-100 p-8 text-ink shadow-[0_40px_60px_-40px_rgba(0,0,0,0.7)] lg:sticky lg:top-28">
        <p class="eyebrow text-tan-deep">For owners</p>
        <p class="mt-3 font-display text-2xl leading-snug">
          Twenty minutes to see what{' '}
          <a href={SITE.avoca} rel="noopener" class="link">
            Avoca
          </a>{' '}
          does for a shop like yours.
        </p>
        <a href={SITE.booking} rel="noopener" class="btn btn-lagoon mt-6 w-full text-base">
          {page.cta}
        </a>
        <p class="mt-3 text-center text-sm text-ink/60">
          Or email{' '}
          <a href={`mailto:${SITE.email}`} class="link">
            {SITE.email}
          </a>
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>
