---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../consts';
import { href } from '../lib/url';
import { islandPath } from '../lib/chart';

interface Props {
  story: CollectionEntry<'stories'>;
  /** 1-based position in the chain; 0 for side quests. */
  index: number;
  total: number;
  prev?: CollectionEntry<'stories'>;
  next?: CollectionEntry<'stories'>;
}
const { story, index, total, prev, next } = Astro.props;
const { title, place, dateLabel, date, excerpt, cover, coverAlt, chart, quest } = story.data;
const url = `${SITE.url}/stories/${story.id}/`;
const pad = (n: number) => String(n).padStart(2, '0');
const eyebrow = quest ? 'Side quests' : `Island ${pad(index)} of ${pad(total)}`;

const article = {
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  author: { '@id': `${SITE.url}/#person` },
  mainEntityOfPage: url,
  ...(cover ? { image: new URL(cover.src, SITE.url).href } : {}),
};
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Stories', item: `${SITE.url}/stories/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<BaseLayout
  title={title}
  description={excerpt}
  type="article"
  tone="light"
  current="/stories/"
  bodyClass="bg-sand-100"
  image={cover?.src}
  imageAlt={coverAlt}
  published={date}
  jsonLd={[article, crumbs]}
>
  <article class="pt-32 pb-24">
    <header class="wrap">
      <div class="flex items-start gap-5">
        <svg class="mt-1 h-16 w-16 shrink-0" viewBox="-40 -40 80 80" aria-hidden="true">
          <circle r="36" fill="var(--color-lagoon)" fill-opacity="0.22"></circle>
          <path
            d={islandPath(3, 5, 18, chart.seed, { scale: 1.25, rough: 0.3 })}
            fill="#061430"
            opacity="0.25"
          ></path>
          <path
            d={islandPath(0, 0, 18, chart.seed, { scale: 1.25, rough: 0.3 })}
            fill="var(--color-sand-300)"
          ></path>
          <path
            d={islandPath(0, 0, 18, chart.seed + 1, { scale: 0.86, rough: 0.5 })}
            fill="var(--color-moss-light)"
          ></path>
        </svg>
        <div>
          <p class="eyebrow text-tan-deep">
            {eyebrow} · {place} · {dateLabel}
          </p>
          <h1 class="mt-3 font-display text-[clamp(2.6rem,6vw,5rem)] leading-[1.02]">{title}</h1>
          <p class="mt-5 max-w-2xl font-display text-2xl leading-snug text-sea-600 italic">
            {excerpt}
          </p>
        </div>
      </div>
    </header>

    {cover && (
      <figure class="wrap mt-12">
        <div class="overflow-hidden rounded-[2rem] ring-1 ring-ink/10">
          <Image
            src={cover}
            alt={coverAlt ?? title}
            widths={[640, 960, 1280, 1800]}
            sizes="(min-width: 1152px) 1104px, 92vw"
            layout="none"
            class="max-h-[72vh] w-full object-cover object-[50%_30%]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        {coverAlt && <figcaption class="eyebrow mt-3 text-ink/50">{coverAlt}</figcaption>}
      </figure>
    )}

    <div class="wrap mt-14">
      <div class="prose prose-sand prose-lg max-w-[68ch] prose-headings:font-display prose-p:leading-[1.75]">
        <slot />
      </div>
    </div>

    <nav aria-label="Between islands" class="wrap mt-20">
      <div class="grid gap-4 border-t border-ink/10 pt-8 sm:grid-cols-2">
        {prev ? (
          <a
            href={href(`/stories/${prev.id}/`)}
            class="group rounded-2xl p-5 ring-1 ring-ink/10 transition hover:bg-white/60"
          >
            <span class="eyebrow text-tan-deep">← Previous island</span>
            <span class="mt-2 block font-display text-2xl group-hover:underline group-hover:decoration-tan group-hover:underline-offset-4">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a
            href={href(`/stories/${next.id}/`)}
            class="group rounded-2xl p-5 text-right ring-1 ring-ink/10 transition hover:bg-white/60"
          >
            <span class="eyebrow text-tan-deep">
              {next.data.quest ? 'Then the side quests →' : 'Next island →'}
            </span>
            <span class="mt-2 block font-display text-2xl group-hover:underline group-hover:decoration-tan group-hover:underline-offset-4">
              {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
      </div>
      <p class="mt-8 text-center">
        <a href={href('/stories/')} class="link text-sea-600">
          Back to the chart
        </a>
      </p>
    </nav>
  </article>
</BaseLayout>
