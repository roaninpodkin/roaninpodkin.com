---
/**
 * Section rail for the home page: a dot per stop with its label, on the right.
 * The active stop follows the scroll. On phones it's a small pill that opens
 * the same list.
 */
interface Stop {
  id: string;
  label: string;
}
interface Props {
  stops: readonly Stop[];
}
const { stops } = Astro.props;
---

<nav aria-label="Sections" class="section-rail text-foam" data-section-rail>
  <ol
    class="fixed top-1/2 right-5 z-40 hidden -translate-y-1/2 flex-col gap-5 lg:flex xl:right-8"
    data-rail
  >
    {stops.map((s) => (
      <li>
        <a
          href={`#${s.id}`}
          data-stop={s.id}
          class="group flex items-center justify-end gap-3 py-1"
        >
          <span class="eyebrow whitespace-nowrap opacity-45 drop-shadow transition group-hover:opacity-100 group-[.is-active]:opacity-100">
            {s.label}
          </span>
          <span class="h-[7px] w-[7px] shrink-0 rounded-full bg-foam/45 drop-shadow transition group-hover:bg-foam group-[.is-active]:bg-foam group-[.is-active]:shadow-[0_0_0_4px_rgba(246,249,250,0.18)]" />
        </a>
      </li>
    ))}
  </ol>

  <details class="fixed right-4 bottom-4 z-40 lg:hidden">
    <summary
      class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-ink/90 px-4 py-2 text-sm shadow-xl ring-1 ring-white/10 backdrop-blur select-none"
      aria-label="Jump to a section"
    >
      <span class="h-[7px] w-[7px] rounded-full bg-foam" aria-hidden="true"></span>
      <span data-rail-label>{stops[0].label}</span>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="opacity-60">
        <path d="M2 7.5 6 3.5l4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </summary>
    <ol class="absolute right-0 bottom-12 w-56 rounded-2xl bg-ink/95 p-2 text-foam shadow-2xl ring-1 ring-white/10">
      {stops.map((s) => (
        <li>
          <a
            href={`#${s.id}`}
            data-stop={s.id}
            class="block rounded-xl px-3 py-2 hover:bg-white/10 [&.is-active]:bg-white/10"
          >
            {s.label}
          </a>
        </li>
      ))}
    </ol>
  </details>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[data-section-rail]');
  if (rail) {
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('[data-stop]'));
    const ids = Array.from(new Set(links.map((a) => a.dataset.stop!)));
    const sections = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    const labelEl = rail.querySelector<HTMLElement>('[data-rail-label]');

    let ticking = false;
    const measure = () => {
      ticking = false;
      const probe = window.scrollY + window.innerHeight * 0.4;
      let active = 0;
      sections.forEach((s, i) => {
        if (probe >= s.getBoundingClientRect().top + window.scrollY) active = i;
      });
      links.forEach((a) => a.classList.toggle('is-active', a.dataset.stop === ids[active]));
      if (labelEl) labelEl.textContent = sections[active]?.dataset.label ?? '';
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(measure);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    measure();
    rail
      .querySelectorAll('details a')
      .forEach((a) =>
        a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
      );
  }
</script>
