---
/**
 * The stories, drawn as islands on a sea chart. Desktop gets the chart;
 * phones get the same route as a vertical list.
 */
import type { CollectionEntry } from 'astro:content';
import { islandPath, openSpline, soundings, type Pt } from '../lib/chart';
import { href } from '../lib/url';

interface Props {
  stories: CollectionEntry<'stories'>[];
  /** Hide the cartouche (used when the page already has a heading). */
  bare?: boolean;
  class?: string;
}
const { stories, bare = false, class: cls = '' } = Astro.props;

const W = 1000;
const H = 640;
const route = openSpline(stories.map((s) => [s.data.chart.x, s.data.chart.y] as Pt));
const marks = soundings(
  34,
  7,
  W,
  H,
  stories.map((s) => ({ x: s.data.chart.x, y: s.data.chart.y, r: s.data.chart.r })),
);

const labelPos = (c: { x: number; y: number; r: number; labelAt: string }) => {
  const gap = c.r * 1.35 + 10;
  switch (c.labelAt) {
    case 'l':
      return { x: c.x - gap, y: c.y + 6, anchor: 'end' };
    case 't':
      return { x: c.x, y: c.y - gap + 2, anchor: 'middle' };
    case 'b':
      return { x: c.x, y: c.y + gap + 12, anchor: 'middle' };
    default:
      return { x: c.x + gap, y: c.y + 6, anchor: 'start' };
  }
};

const badgePos = (c: { x: number; y: number; r: number; labelAt: string }) =>
  c.labelAt === 't'
    ? { x: c.x - c.r * 1.55 - 6, y: c.y - c.r * 0.9 }
    : { x: c.x, y: c.y - c.r * 1.3 - 6 };

const pad = (n: number) => String(n).padStart(2, '0');
---

<div class={`sea-chart ${cls}`}>
  <!-- Desktop / tablet: the chart -->
  <svg
    class="hidden w-full md:block"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby="chart-title chart-desc"
  >
    <title id="chart-title">A chart of Roanin's stories</title>
    <desc id="chart-desc">
      {stories.length} islands connected by a dotted route, in order:{' '}
      {stories.map((s) => s.data.title).join(', ')}. Each island links to its story.
    </desc>

    <defs>
      <radialGradient id="shoal-grad" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-lagoon)" stop-opacity="0.45"></stop>
        <stop offset="70%" stop-color="var(--color-lagoon)" stop-opacity="0.12"></stop>
        <stop offset="100%" stop-color="var(--color-lagoon)" stop-opacity="0"></stop>
      </radialGradient>
      <pattern id="grid" width="50" height="50" patternUnits="userSpaceOnUse">
        <path
          d="M50 0H0V50"
          fill="none"
          stroke="currentColor"
          stroke-opacity="0.09"
          stroke-width="0.6"
        ></path>
      </pattern>
    </defs>

    <!-- Paper: grid and rhumb lines -->
    <rect width={W} height={H} fill="url(#grid)"></rect>
    <g stroke="currentColor" stroke-opacity="0.07" stroke-width="0.6">
      {Array.from({ length: 12 }, (_, i) => {
        const a = (i / 12) * Math.PI;
        const L = 1400;
        const cx = 905;
        const cy = 95;
        return (
          <line
            x1={cx - Math.cos(a) * L}
            y1={cy - Math.sin(a) * L}
            x2={cx + Math.cos(a) * L}
            y2={cy + Math.sin(a) * L}
          />
        );
      })}
    </g>

    <!-- Soundings -->
    <g
      class="font-display"
      font-size="11"
      fill="currentColor"
      fill-opacity="0.38"
      font-style="italic"
    >
      {marks.map((m) => (
        <text x={m.x} y={m.y} text-anchor="middle">
          {m.v}
        </text>
      ))}
    </g>

    <!-- Route -->
    <path
      d={route}
      fill="none"
      stroke="var(--color-tan)"
      stroke-width="1.6"
      stroke-dasharray="1 7"
      stroke-linecap="round"
      opacity="0.9"
    ></path>

    <!-- Islands -->
    {stories.map((s, i) => {
      const c = s.data.chart;
      const lp = labelPos(c);
      const bp = badgePos(c);
      const peak = c.kind === 'peak';
      const atoll = c.kind === 'atoll';
      return (
        <a
          href={href(`/stories/${s.id}/`)}
          class="island"
          aria-label={`${s.data.title}, ${s.data.place}`}
        >
          <circle class="shoal" cx={c.x} cy={c.y} r={c.r * 2.3} fill="url(#shoal-grad)" />
          <path
            d={islandPath(c.x, c.y, c.r, c.seed, { scale: 1.22, rough: 0.3 })}
            fill="var(--color-sand-200)"
          />
          <path
            d={islandPath(c.x, c.y, c.r, c.seed + 1, { scale: 0.86, rough: 0.5 })}
            fill={peak ? 'var(--color-moss)' : 'var(--color-moss-light)'}
          />
          {atoll && (
            <path
              d={islandPath(c.x + c.r * 1.6, c.y + c.r * 0.9, c.r * 0.45, c.seed + 9, {
                scale: 1,
                rough: 0.5,
              })}
              fill="var(--color-sand-200)"
            />
          )}
          {peak && (
            <path
              d={`M${c.x - c.r * 0.5} ${c.y + c.r * 0.35} L${c.x} ${c.y - c.r * 0.6} L${c.x + c.r * 0.5} ${c.y + c.r * 0.35} Z`}
              fill="var(--color-sand-100)"
              opacity="0.9"
            />
          )}
          <g class="badge">
            <circle cx={bp.x} cy={bp.y} r="8" fill="var(--color-ink)" />
            <text
              x={bp.x}
              y={bp.y + 3}
              text-anchor="middle"
              font-size="8.5"
              font-weight="600"
              fill="var(--color-foam)"
              class="font-sans"
            >
              {pad(i + 1)}
            </text>
          </g>
          <text
            x={lp.x}
            y={lp.y}
            text-anchor={lp.anchor}
            class="label font-display"
            font-size="21"
            font-style="italic"
            fill="currentColor"
          >
            {s.data.title}
          </text>
        </a>
      );
    })}

    <!-- Compass rose -->
    <g transform="translate(905 95)" fill="currentColor" stroke="currentColor" opacity="0.8">
      <circle r="26" fill="none" stroke-opacity="0.35" stroke-width="0.8"></circle>
      <circle r="3" stroke="none"></circle>
      <path d="M0-30 L6 0 L0 30 L-6 0 Z" fill-opacity="0.9" stroke="none"></path>
      <path d="M-30 0 L0 6 L30 0 L0-6 Z" fill-opacity="0.45" stroke="none"></path>
      <text y="-38" text-anchor="middle" font-size="12" class="font-display" stroke="none">
        N
      </text>
    </g>

    {!bare && (
      <g transform="translate(36 36)" fill="currentColor">
        <rect
          width="214"
          height="78"
          rx="6"
          fill="var(--color-ink)"
          fill-opacity="0.35"
          stroke="currentColor"
          stroke-opacity="0.35"
        />
        <text x="16" y="31" class="font-display" font-size="24">
          Stories
        </text>
        <text
          x="16"
          y="52"
          font-size="11"
          fill-opacity="0.75"
          class="font-sans"
          letter-spacing="1.5"
        >
          A CHART OF WHERE I'VE BEEN
        </text>
        <line x1="16" y1="64" x2="96" y2="64" stroke="currentColor" stroke-width="1.5" />
        <line x1="16" y1="60" x2="16" y2="68" stroke="currentColor" />
        <line x1="96" y1="60" x2="96" y2="68" stroke="currentColor" />
        <text x="104" y="68" font-size="10" fill-opacity="0.7" class="font-sans">
          one story
        </text>
      </g>
    )}
  </svg>

  <!-- Phone: the same route as a list -->
  <ol class="relative ml-5 space-y-10 border-l border-dashed border-current/35 pl-9 md:hidden">
    {stories.map((s, i) => {
      const c = s.data.chart;
      return (
        <li class="relative">
          <svg
            class="absolute -left-[3.55rem] top-0 h-11 w-11"
            viewBox="-40 -40 80 80"
            aria-hidden="true"
          >
            <circle r="34" fill="var(--color-lagoon)" fill-opacity="0.18" />
            <path
              d={islandPath(0, 0, 18, c.seed, { scale: 1.25, rough: 0.3 })}
              fill="var(--color-sand-200)"
            />
            <path
              d={islandPath(0, 0, 18, c.seed + 1, { scale: 0.86, rough: 0.5 })}
              fill="var(--color-moss-light)"
            />
          </svg>
          <a href={href(`/stories/${s.id}/`)} class="group block">
            <p class="eyebrow opacity-70">
              {pad(i + 1)} · {s.data.place} · {s.data.dateLabel}
            </p>
            <h3 class="mt-1 font-display text-3xl leading-tight group-hover:underline group-hover:decoration-tan group-hover:underline-offset-4">
              {s.data.title}
            </h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed opacity-80">{s.data.excerpt}</p>
          </a>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .island {
    cursor: pointer;
  }
  .island .shoal {
    transition: transform 0.5s var(--ease-soft);
    transform-box: fill-box;
    transform-origin: center;
  }
  .island:hover .shoal,
  .island:focus-visible .shoal {
    transform: scale(1.18);
  }
  .island .label {
    transition: fill 0.2s;
  }
  .island:hover .label,
  .island:focus-visible .label {
    fill: var(--color-tan);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .island:focus-visible {
    outline: none;
  }
  .island:focus-visible .shoal {
    stroke: var(--color-lagoon);
    stroke-width: 2;
  }
  .island .badge {
    opacity: 0.85;
  }
</style>
