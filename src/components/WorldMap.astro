---
/**
 * A world map with a pin for every logbook album that has coordinates.
 * The land outlines are generated at build time from Natural Earth data,
 * so the page ships plain SVG and no map library.
 */
import { feature } from 'topojson-client';
import { geoNaturalEarth1, geoPath, geoGraticule10 } from 'd3-geo';
import type { Topology, GeometryCollection } from 'topojson-specification';
import type { FeatureCollection } from 'geojson';
import world from 'world-atlas/land-110m.json';
import { href } from '../lib/url';

export interface Pin {
  slug: string;
  title: string;
  place: string;
  coords: [number, number];
  count: number;
}
interface Props {
  pins: Pin[];
}
const { pins } = Astro.props;

const W = 1000;
const H = 480;
const topo = world as unknown as Topology<{ land: GeometryCollection }>;
const land = feature(topo, topo.objects.land) as unknown as FeatureCollection;
const projection = geoNaturalEarth1().fitSize([W, H], land);
const path = geoPath(projection);
const landD = path(land) ?? '';
const gratD = path(geoGraticule10()) ?? '';
const placed = pins
  .map((p) => {
    const xy = projection([p.coords[1], p.coords[0]]);
    return xy ? { ...p, x: xy[0], y: xy[1] } : null;
  })
  .filter((p): p is Pin & { x: number; y: number } => p !== null);
---

<div class="world-map relative">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="w-full"
    role="group"
    aria-label="World map with pins where photos were taken"
  >
    <g aria-hidden="true">
      <path d={gratD} fill="none" stroke="#fff" stroke-opacity="0.07" stroke-width="0.6"></path>
      <path
        d={landD}
        fill="var(--color-sand-200)"
        fill-opacity="0.9"
        stroke="#fff"
        stroke-opacity="0.25"
        stroke-width="0.6"
      ></path>
    </g>
    {placed.map((p) => (
      <a
        href={href(`/logbook/${p.slug}/`)}
        class="pin"
        aria-label={`${p.title}, ${p.place}: ${p.count} ${p.count === 1 ? 'photo' : 'photos'}`}
      >
        <circle cx={p.x} cy={p.y} r="16" fill="transparent" />
        <circle
          class="ring"
          cx={p.x}
          cy={p.y}
          r="6"
          fill="none"
          stroke="var(--color-lagoon)"
          stroke-width="1.5"
        />
        <circle
          class="dot"
          cx={p.x}
          cy={p.y}
          r="4"
          fill="var(--color-lagoon)"
          stroke="var(--color-ink)"
          stroke-width="1"
        />
        <g class="tip" transform={`translate(${p.x} ${p.y - 14})`}>
          <text
            text-anchor="middle"
            font-size="13"
            class="font-display"
            font-style="italic"
            fill="var(--color-foam)"
          >
            {p.title}
          </text>
        </g>
      </a>
    ))}
  </svg>
</div>

<style>
  .pin {
    cursor: pointer;
  }
  .pin .ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse-ring 2.8s ease-out infinite;
  }
  .pin .tip {
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
    paint-order: stroke;
    stroke: var(--color-ink);
    stroke-width: 3px;
  }
  .pin:hover .tip,
  .pin:focus-visible .tip {
    opacity: 1;
  }
  .pin:hover .dot,
  .pin:focus-visible .dot {
    fill: var(--color-tan);
  }
  .pin:focus-visible {
    outline: none;
  }
  @keyframes pulse-ring {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pin .ring {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
